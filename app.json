{
  "expo": {
    "name": "AI-PM",
    "slug": "ai-pm-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aipm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aipm.mobile",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "AI-PM uses Face ID to protect access to your project data."
      }
    },
    "android": {
      "package": "com.aipm.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b0f14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI-PM to attach photos to issues.",
          "cameraPermission": "Allow AI-PM to capture issue attachments."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
