{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "unsigned-ios": {
      "channel": "internal",
      "environment": "production",
      "ios": {
        "withoutCredentials": true,
        "config": "unsigned-ios.yml"
      }
    },
    "internal-ios": {
      "distribution": "internal",
      "channel": "internal",
      "environment": "production"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  }
}
