# API reachable from the physical device/emulator.
# Android emulator example: http://10.0.2.2:4000/api/v1
# Physical device example: http://192.168.1.10:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Required for Expo Push Token registration on real devices.
# Obtain it after linking this app to an Expo/EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=
